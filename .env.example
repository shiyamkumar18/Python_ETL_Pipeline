# Local shell defaults. For Docker Compose, service hostnames are already set.
ETL_SOURCE_TYPE=api
ETL_SOURCE_FILE_PATH=data/sample_raw_events.json
ETL_SOURCE_API_BASE_URL=http://localhost:8000
ETL_DATABASE_URL=postgresql://subly:subly@localhost:5432/subly
ETL_SOURCE_API_TIMEOUT_SEC=10
ETL_SOURCE_API_MAX_RETRIES=4
ETL_SOURCE_API_BACKOFF_SEC=1
ETL_SOURCE_BATCH_SIZE=500
ETL_DB_INSERT_BATCH_SIZE=500
ETL_REJECT_EVENT_AGE_DAYS=30
ETL_REJECT_RATE_THRESHOLD_PCT=5.0
ETL_MAX_PROPERTIES_KEYS=10
ETL_MAX_PROPERTIES_BYTES=1024
ETL_LOG_LEVEL=INFO
ETL_DATA_DIR=data
ETL_QUARANTINE_DIR=data/quarantine
ETL_METRICS_DIR=data/metrics
